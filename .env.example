# Скопируйте в .env и при необходимости измените.

# Токен GitHub (рекомендуется): ускоряет сбор в 3 раза (30 вместо 10 запросов поиска в минуту).
# Создать: https://github.com/settings/tokens — никакие scopes не нужны.
GITHUB_TOKEN=

# Объёмы сбора
GITHUB_TARGET=12000
NPM_TARGET=12000
NPM_DEPS_LIMIT=3000
HN_COMMENT_STORIES=300

# Масштабирование
GATEWAY_REPLICAS=2
SUBGRAPH_REPLICAS=1

# Контроль нагрузки
MAX_QUERY_DEPTH=12
MAX_QUERY_COMPLEXITY=5000
COST_BUDGET_PER_MIN=100000
RATE_LIMIT_PER_MIN=600
MAX_INFLIGHT_REQUESTS=200

# Доля трассируемых запросов (0..1)
TRACE_SAMPLE_RATIO=1.0

FRONTEND_PORT=8080
